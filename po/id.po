#: data/icons.metainfo.xml.in:10
msgid "elementary Icons"
msgstr "Ikon elementary"

#: data/icons.metainfo.xml.in:11
msgid "Named, vector icons for elementary OS"
msgstr "Ikon vektor bernama untuk elementary OS"

#: data/icons.metainfo.xml.in:14
msgid ""
"An original set of vector icons designed specifically for elementary OS and "
"its desktop environment: Pantheon."
msgstr ""
"Satu set ikon vektor asli yang dirancang khusus untuk elementary OS dan "
"lingkungan desktopnya: Pantheon."

#: data/icons.metainfo.xml.in:34 data/icons.metainfo.xml.in:58
#: data/icons.metainfo.xml.in:93 data/icons.metainfo.xml.in:120
#: data/icons.metainfo.xml.in:183
msgid "Additions:"
msgstr "Penambahan:"

#: data/icons.metainfo.xml.in:36 data/icons.metainfo.xml.in:61
msgid "Tool icons for Inkscape"
msgstr "Ikon alat untuk Inkscape"

#: data/icons.metainfo.xml.in:37
msgid "16px `camera-photo`"
msgstr "`camera-photo` 16px"

#: data/icons.metainfo.xml.in:38
msgid "48px, 64px, and 128px app icons"
msgstr "Ikon aplikasi 48px, 64px, dan 128px"

#: data/icons.metainfo.xml.in:40 data/icons.metainfo.xml.in:66
#: data/icons.metainfo.xml.in:100 data/icons.metainfo.xml.in:132
#: data/icons.metainfo.xml.in:168 data/icons.metainfo.xml.in:196
msgid "Updated families:"
msgstr "Keluarga diperbarui:"

#: data/icons.metainfo.xml.in:42
msgid "Make `process-stop` and `process-completed` visually match"
msgstr "Selaraskan tampilan `process-stop` dan `process-completed`"

#: data/icons.metainfo.xml.in:44 data/icons.metainfo.xml.in:74
#: data/icons.metainfo.xml.in:127 data/icons.metainfo.xml.in:163
#: data/icons.metainfo.xml.in:191
msgid "Removals:"
msgstr "Penghapusan:"

#: data/icons.metainfo.xml.in:46
msgid "`office-calendar`"
msgstr "`office-calendar`"

#: data/icons.metainfo.xml.in:60
msgid "`start-here`"
msgstr "`start-here`"

#: data/icons.metainfo.xml.in:62
msgid "Add Adwaita as a fallback for icon names"
msgstr "Tambah Adwaita sebagai cadangan untuk nama ikon"

#: data/icons.metainfo.xml.in:63
msgid ""
"16px `accessories-character-map`, `document-properties`, `preferences-system`"
msgstr ""
"`accessories-character-map`, `document-properties`, `preferences-system` 16px"

#: data/icons.metainfo.xml.in:64
msgid "24px `list-add-symbolic`"
msgstr "`list-add-symbolic` 24px"

#: data/icons.metainfo.xml.in:68
msgid "Add a scroll wheel to mouse"
msgstr "Tambah roda gulir pada tetikus"

#: data/icons.metainfo.xml.in:69
msgid "Use outline style for `applications-internet-symbolic`"
msgstr "Gunakan gaya garis luar untuk `applications-internet-symbolic`"

#: data/icons.metainfo.xml.in:70
msgid "Differentiate keyboard device from keyboard preferences"
msgstr "Bedakan perangkat papan ketik dari preferensi papan ketik"

#: data/icons.metainfo.xml.in:71
msgid "Round find-location"
msgstr "Bulatkan find-location"

#: data/icons.metainfo.xml.in:72
msgid "Remove visual artifact from 16px `edit-paste` icon"
msgstr "Hapus artefak visual dari ikon `edit-paste` 16px"

#: data/icons.metainfo.xml.in:76
msgid "`view-filter`"
msgstr "`view-filter`"

#: data/icons.metainfo.xml.in:77
msgid "`media-memory`"
msgstr "`media-memory`"

#: data/icons.metainfo.xml.in:95
msgid "import and export actions at 16px"
msgstr "aksi impor dan ekspor pada 16px"

#: data/icons.metainfo.xml.in:96
msgid "`mail-send-receive` now has a color version"
msgstr "`mail-send-receive` kini memiliki versi berwarna"

#: data/icons.metainfo.xml.in:97
msgid ""
"`system-software-install` has a new icon, separate from the AppCenter "
"branding"
msgstr ""
"`system-software-install` memiliki ikon baru, terpisah dari identitas merek "
"AppCenter"

#: data/icons.metainfo.xml.in:98
msgid "symlinks are now handled in the build system"
msgstr "symlink kini ditangani di sistem build"

#: data/icons.metainfo.xml.in:102
msgid "Fixed color, pagesizes, and grid alignment for all symbolic icons"
msgstr ""
"Perbaiki warna, ukuran halaman, dan perataan kisi untuk semua ikon simbolik"

#: data/icons.metainfo.xml.in:103
msgid ""
"`text` and `text-vertical` cursors have new designs, matching the new cursor "
"style from 8.0.0"
msgstr ""
"Kursor `text` dan `text-vertical` memiliki desain baru, selaras dengan gaya "
"kursor baru dari 8.0.0"

#: data/icons.metainfo.xml.in:104
msgid "Chat bubbles are now used for `user-*` status icons"
msgstr "Balon obrolan kini digunakan untuk ikon status `user-*`"

#: data/icons.metainfo.xml.in:105
msgid ""
"`preferences-desktop-locacle-symbolic` has been updated to be closer to the "
"color version"
msgstr ""
"`preferences-desktop-locacle-symbolic` diperbarui agar lebih mendekati versi "
"berwarna"

#: data/icons.metainfo.xml.in:106
msgid ""
"The colors of the magnifying glass in print preview actions has been unified "
"with that of the find action"
msgstr ""
"Warna kaca pembesar pada aksi pratinjau cetak diseragamkan dengan warna aksi "
"find"

#: data/icons.metainfo.xml.in:107
msgid "`mail-message-new` has been made more uniform across its variations"
msgstr "`mail-message-new` dibuat lebih seragam di seluruh variasinya"

#: data/icons.metainfo.xml.in:108
msgid "`save-as-symbolic` has a new design to differentiate from `save`"
msgstr "`save-as-symbolic` memiliki desain baru untuk membedakannya dari `save`"

#: data/icons.metainfo.xml.in:109
msgid ""
"session icons (`system-*`) have had minor updates to shape language and "
"color added"
msgstr ""
"ikon sesi (`system-*`) mendapat pembaruan kecil pada bahasa bentuk dan "
"penambahan warna"

#: data/icons.metainfo.xml.in:122
msgid ""
"`preferences-desktop-wallpaper` is now a unique icon from `preferences-"
"desktop` and features a colorful paint roller design"
msgstr ""
"`preferences-desktop-wallpaper` kini menjadi ikon tersendiri dari "
"`preferences-desktop` dan menampilkan desain rol cat berwarna"

#: data/icons.metainfo.xml.in:123
msgid ""
"`accessories-screenshot-tool` and the symlink `applets-screenshooter` are "
"added to cover icons expected by the Portals backend"
msgstr ""
"`accessories-screenshot-tool` dan symlink `applets-screenshooter` "
"ditambahkan untuk memenuhi ikon yang diharapkan backend Portals"

#: data/icons.metainfo.xml.in:124
msgid "`usb-receiver` to cover peripheral receivers in FWUPD"
msgstr "`usb-receiver` untuk mencakup penerima periferal di FWUPD"

#: data/icons.metainfo.xml.in:125
msgid "`system-log-out-symbolic`"
msgstr "`system-log-out-symbolic`"

#: data/icons.metainfo.xml.in:129
msgid "`bug`"
msgstr "`bug`"

#: data/icons.metainfo.xml.in:130
msgid "`preferences-system-parental-controls`"
msgstr "`preferences-system-parental-controls`"

#: data/icons.metainfo.xml.in:134
msgid ""
"Cursors have been completely redrawn with a new base pointer shape, colorful "
"badges, and a new color wheel design for waiting states"
msgstr ""
"Kursor digambar ulang sepenuhnya dengan bentuk penunjuk dasar baru, lencana "
"berwarna, dan desain roda warna baru untuk keadaan menunggu"

#: data/icons.metainfo.xml.in:135
msgid ""
"Use brighter colors for `edit-find` icons and add missing 16px `edit-find-"
"replace`"
msgstr ""
"Gunakan warna yang lebih cerah untuk ikon `edit-find` dan tambahkan `edit-"
"find-replace` 16px yang hilang"

#: data/icons.metainfo.xml.in:136
msgid "Update the border radius of `preferences-desktop-locale`"
msgstr "Perbarui radius sudut `preferences-desktop-locale`"

#: data/icons.metainfo.xml.in:137
msgid "`window-*` icons use more rounded arrow shapes"
msgstr "ikon `window-*` menggunakan bentuk panah yang lebih membulat"

#: data/icons.metainfo.xml.in:138
msgid "`system-*-symbolic` icons are a more uniform size"
msgstr "ikon `system-*-symbolic` berukuran lebih seragam"

#: data/icons.metainfo.xml.in:139
msgid "halign checkmark on 32px `process-completed`"
msgstr "ratakan horizontal tanda centang pada `process-completed` 32px"

#: data/icons.metainfo.xml.in:140
msgid "redesign `preferences-system` with higher contrast and more detail"
msgstr ""
"desain ulang `preferences-system` dengan kontras lebih tinggi dan detail "
"lebih banyak"

#: data/icons.metainfo.xml.in:141
msgid "clean up 128 drive-harddisk"
msgstr "bersihkan drive-harddisk 128"

#: data/icons.metainfo.xml.in:142
msgid "Fix grid alignment of several `document-*` icons"
msgstr "Perbaiki perataan kisi beberapa ikon `document-*`"

#: data/icons.metainfo.xml.in:143
msgid "Use a bell for `preferences-system-notification`"
msgstr "Gunakan lonceng untuk `preferences-system-notification`"

#: data/icons.metainfo.xml.in:165
msgid ""
"non-fd.o \"bluetooth-*\", \"microphone-sensitivity-*\", and \"night-light\" "
"symbolic panel icons"
msgstr ""
"ikon panel simbolik non-fd.o \"bluetooth-*\", \"microphone-sensitivity-*\", "
"dan \"night-light\""

#: data/icons.metainfo.xml.in:166
msgid "\"mail-archive\" and \"mail-move\""
msgstr "\"mail-archive\" dan \"mail-move\""

#: data/icons.metainfo.xml.in:170
msgid "\"insert-image-symbolic\" is now more detailed"
msgstr "\"insert-image-symbolic\" kini lebih detail"

#: data/icons.metainfo.xml.in:171
msgid "\"media-record\" has an updated palette"
msgstr "\"media-record\" memiliki palet yang diperbarui"

#: data/icons.metainfo.xml.in:172
msgid ""
"\"document-page-setup\", \"edit-copy\", \"edit-cut\", \"media-optical\", "
"\"open-menu\", \"system-run\" look better on dark backgrounds"
msgstr ""
"\"document-page-setup\", \"edit-copy\", \"edit-cut\", \"media-optical\", "
"\"open-menu\", \"system-run\" terlihat lebih baik pada latar gelap"

#: data/icons.metainfo.xml.in:173
msgid ""
"Improved arrow shape for \"browser-download\", \"document-send\", \"document-"
"import/export\", \"object-merge\", \"object-rotate\", \"pane-hide/show\", "
"and \"view-refresh\""
msgstr ""
"Bentuk panah yang lebih baik untuk \"browser-download\", \"document-send\", "
"\"document-import/export\", \"object-merge\", \"object-rotate\", \"pane-hide/"
"show\", dan \"view-refresh\""

#: data/icons.metainfo.xml.in:185
msgid "\"list-drag-handle-symbolic\" as used in draggable list box rows"
msgstr ""
"\"list-drag-handle-symbolic\" seperti yang digunakan pada baris kotak daftar "
"yang dapat diseret"

#: data/icons.metainfo.xml.in:186
msgid ""
"\"selection-mode-symbolic\" as used in apps which have a button to switch a "
"list into a selection mode"
msgstr ""
"\"selection-mode-symbolic\" seperti yang digunakan pada aplikasi yang "
"memiliki tombol untuk mengalihkan daftar ke mode pilihan"

#: data/icons.metainfo.xml.in:187
msgid "\"adw-expander-arrow-symbolic\" as used in Adw.PreferencesWindow"
msgstr ""
"\"adw-expander-arrow-symbolic\" seperti yang digunakan di "
"Adw.PreferencesWindow"

#: data/icons.metainfo.xml.in:188
msgid "\"adw-external-link-symbolic\" as used in Adw.AboutWindow"
msgstr ""
"\"adw-external-link-symbolic\" seperti yang digunakan di Adw.AboutWindow"

#: data/icons.metainfo.xml.in:189
msgid "\"adw-tab-*\" icons as used with Adw.Tabbar"
msgstr "ikon \"adw-tab-*\" seperti yang digunakan dengan Adw.Tabbar"

#: data/icons.metainfo.xml.in:193
msgid ""
"\"network-*\" status icons which are not in the FreeDesktop icon name "
"specification"
msgstr ""
"ikon status \"network-*\" yang tidak ada dalam spesifikasi nama ikon "
"FreeDesktop"

#: data/icons.metainfo.xml.in:194
msgid ""
"Device icons which are not in the FreeDesktop icon name specification: "
"\"camera\", \"drive-cdrom\", \"media-cdrom\", \"music-player\", \"printer-"
"remote\", and \"system\""
msgstr ""
"Ikon perangkat yang tidak ada dalam spesifikasi nama ikon FreeDesktop: "
"\"camera\", \"drive-cdrom\", \"media-cdrom\", \"music-player\", \"printer-"
"remote\", dan \"system\""

#: data/icons.metainfo.xml.in:198
msgid ""
"\"process-completed\" uses a new checkmark shape, has a 32px version, and "
"symlinks were added for \"emblem-default\""
msgstr ""
"\"process-completed\" menggunakan bentuk tanda centang baru, memiliki versi "
"32px, dan symlink ditambahkan untuk \"emblem-default\""

#: data/icons.metainfo.xml.in:199
msgid "Updated corner radius of \"edit-clear\" and \"document-*-symbolic\""
msgstr "Perbarui radius sudut \"edit-clear\" dan \"document-*-symbolic\""

#: data/icons.metainfo.xml.in:200
msgid "Updated \"preferences-desktop-display\" and added a 64px version"
msgstr "Perbarui \"preferences-desktop-display\" dan tambahkan versi 64px"

